msgid "Multiple {game} installations detected. Pass --game-path to select one."
msgstr ""
"Mehrere {game}-Installationen erkannt. Übergib --game-path, um eine "
"auszuwählen."

#: src/cli.rs:1163
msgid ""
"No mod selection specified. Pass --all-mods, --preset <name>, or --mods "
"<slug1,slug2>.\n"
"Use 'list-mods --game {game}' to see available mods and presets."
msgstr ""
"Keine Modauswahl angegeben. Übergib --all-mods, --preset <Name> oder --mods "
"<slug1,slug2>.\n"
"Verwende 'list-mods --game {game}', um verfügbare Mods und Voreinstellungen "
"zu sehen."

