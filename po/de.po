msgid "Library folders file not found: {path}"
msgstr "Bibliotheksordner-Datei nicht gefunden: {path}"

#: src/cli.rs:1214
msgid "{game} was not detected. Pass --game-path."
msgstr "{game} wurde nicht erkannt. Übergib --game-path."

#: src/cli.rs:1219
msgid ""
"{game} is in a Steam library that cannot be accessed: {paths}. Mount the "
"drive, or grant access to it in the Adventure Mods window, or pass --steam-"
"library or --game-path."
msgstr ""
"{game} liegt in einer Steam-Bibliothek, auf die nicht zugegriffen werden "
"kann: {paths}. Binde das Laufwerk ein, gewähre den Zugriff im Fenster von "
"Adventure Mods oder übergib --steam-library oder --game-path."

#: src/cli.rs:1232
msgid "Unknown game '{game}'. Use 'sadx' or 'sa2'."
msgstr "Unbekanntes Spiel '{game}'. Verwende 'sadx' oder 'sa2'."

