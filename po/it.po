msgid "Multiple {game} installations detected. Pass --game-path to select one."
msgstr ""
"Rilevate più installazioni di {game}. Passa --game-path per sceglierne una."

#: src/cli.rs:1163
msgid ""
"No mod selection specified. Pass --all-mods, --preset <name>, or --mods "
"<slug1,slug2>.\n"
"Use 'list-mods --game {game}' to see available mods and presets."
msgstr ""
"Nessuna selezione di mod indicata. Passa --all-mods, --preset <nome> o --"
"mods <slug1,slug2>.\n"
"Usa 'list-mods --game {game}' per vedere i mod e i preset disponibili."

