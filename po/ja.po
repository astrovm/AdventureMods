msgid "SAModManager.exe not found in release archive"
msgstr "リリースアーカイブに SAModManager.exe が見つかりません"

#: src/setup/common.rs:411
msgid "Mod loader DLL not found at {path}"
msgstr "Mod ローダーの DLL が {path} にありません"

#: src/setup/common.rs:930
msgid ""
"Expected archive to contain a single top-level mod directory, found {count} "
