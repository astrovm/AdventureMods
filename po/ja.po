#: src/cli.rs
msgid "No supported games detected."
msgstr "対応しているゲームが見つかりません。"

#: src/cli.rs
msgid "Detected games:"
msgstr "見つかったゲーム："

#: src/cli.rs
msgid "Inaccessible Steam libraries:"
msgstr "アクセスできないSteamライブラリ："

#: src/cli.rs
#, rust-format
msgid "Game: {game}"
msgstr "ゲーム：{game}"

#: src/cli.rs
msgid "Presets:"
msgstr "プリセット："

#: src/cli.rs
msgid "Mods:"
msgstr "Mod："

#: src/cli.rs
#, rust-format
msgid "Restoring {game} at {path}"
msgstr "{path} の {game} を元に戻しています"

#: src/cli.rs
msgid "Nothing to restore: this game was not modified by setup."
msgstr "元に戻すものはありません。このゲームはセットアップで変更されていません。"

#: src/cli.rs
#, rust-format
msgid "The game was converted to the 2004 version. Verify its files in Steam to get the Steam version back: {uri}"
msgstr "ゲームは2004年版に変換されています。Steamでファイルの整合性を確認すると、Steam版に戻ります：{uri}"

#: src/cli.rs
msgid "Restore complete!"
msgstr "元に戻しました！"

#: src/cli.rs
#, rust-format
msgid "Setting up {game} at {path}"
msgstr "{path} の {game} をセットアップしています"

#: src/cli.rs
msgid "Setup complete!"
msgstr "セットアップが完了しました！"

#: src/cli.rs
#, rust-format
msgid "Step {index}/{total}: {label}"
msgstr "ステップ {index}/{total}：{label}"

#: src/cli.rs src/ui/setup.rs
msgid "Done"
msgstr "完了"

#: src/cli.rs
#, rust-format
msgid "{size} MB downloaded"
msgstr "{size} MB ダウンロード済み"

#: src/cli.rs src/ui/progress.rs
#, rust-format
msgid "{size} MB"
msgstr "{size} MB"

#: src/cli.rs
#, rust-format
msgid "{done} / {total} MB ({percent}%)"
msgstr "{done} / {total} MB（{percent}%）"

#: src/cli.rs
#, rust-format
msgid "Installing: {name}"
msgstr "インストール中：{name}"

#: src/cli.rs
#, rust-format
msgid "Installed: {name}"
msgstr "インストール済み：{name}"

#: src/cli.rs
msgid "Saving mod settings…"
msgstr "Modの設定を保存しています…"

#: src/cli.rs
#, rust-format
msgid "Subtitle language '{value}' is not supported for {game}."
msgstr "字幕の言語「{value}」は{game}では使えません。"

#: src/cli.rs
msgid "Subtitle language"
msgstr "字幕の言語"

#: src/cli.rs
msgid "Voice language"
msgstr "音声の言語"

#: src/cli.rs
msgid "Select game"
msgstr "ゲームを選んでください"

#: src/cli.rs
msgid "No supported games detected. Pass --game and --game-path."
msgstr "対応しているゲームが見つかりません。--game と --game-path を指定してください。"

#: src/cli.rs
msgid "Select installation"
msgstr "インストール先を選んでください"

#: src/cli.rs
#, rust-format
msgid "Select {game} installation"
msgstr "{game}のインストール先を選んでください"

#: src/cli.rs
msgid "Cannot use both --preset and --mods at the same time"
msgstr "--preset と --mods は同時に使えません"

#: src/cli.rs
msgid "Cannot use --all-mods with --preset"
msgstr "--all-mods と --preset は同時に使えません"

#: src/cli.rs
msgid "Cannot use --all-mods with --mods"
msgstr "--all-mods と --mods は同時に使えません"

#: src/cli.rs
msgid "--mods requires at least one mod slug"
msgstr "--mods にはModのスラッグが1つ以上必要です"

#: src/cli.rs
#, rust-format
msgid "Unknown mod slug '{slug}'. Use 'list-mods --game {game}' to see valid slugs."
msgstr "不明なModのスラッグ「{slug}」です。使えるスラッグは「list-mods --game {game}」で確認できます。"

#: src/cli.rs
msgid "Install all recommended mods"
msgstr "おすすめのModをすべてインストール"

#: src/cli.rs
msgid "Choose mods manually"
msgstr "Modを自分で選ぶ"

#: src/cli.rs
msgid "Choose setup mode"
msgstr "セットアップの方法を選んでください"

#: src/cli.rs
msgid "Select mods (space to toggle, enter to confirm)"
msgstr "Modを選んでください（スペースで切り替え、Enterで決定）"

#: src/cli.rs
msgid "Select at least one mod."
msgstr "Modを1つ以上選んでください。"

#: src/cli.rs
#, rust-format
msgid "Invalid mod selection {number}"
msgstr "Modの選択が正しくありません：{number}"

#: src/cli.rs
msgid "Summary"
msgstr "概要"

#: src/cli.rs
#, rust-format
msgid "Path: {path}"
msgstr "パス：{path}"

#: src/cli.rs
#, rust-format
msgid "Resolution: {width}x{height}"
msgstr "解像度：{width}x{height}"

#: src/cli.rs
#, rust-format
msgid "Subtitle language: {language}"
msgstr "字幕の言語：{language}"

#: src/cli.rs
#, rust-format
msgid "Voice language: {language}"
msgstr "音声の言語：{language}"

#: src/cli.rs
#, rust-format
msgid "Mods selected: {count}"
msgstr "選んだMod：{count}"

#: src/cli.rs
msgid "Proceed with setup?"
msgstr "セットアップを始めますか？"

#: src/cli.rs
msgid "Setup cancelled"
msgstr "セットアップを中止しました"

#: src/cli.rs
msgid ""
"--game-path requires --game in non-interactive mode.\n"
"Pass --game sadx or --game sa2."
msgstr ""
"非対話モードでは --game-path に --game が必要です。\n"
"--game sadx か --game sa2 を指定してください。"

#: src/cli.rs
#, rust-format
msgid "Multiple games detected ({games}). Pass --game to select one."
msgstr "複数のゲームが見つかりました（{games}）。--game で1つ選んでください。"

#: src/cli.rs
#, rust-format
msgid "Game path does not exist or is not a directory: {path}"
msgstr "ゲームのパスが存在しないか、フォルダーではありません：{path}"

#: src/cli.rs
#, rust-format
msgid "{path} does not appear to be a {game} installation (expected game executable)"
msgstr "{path} は{game}のインストール先ではないようです（ゲームの実行ファイルが見つかりません）"

#: src/cli.rs
#, rust-format
msgid "Multiple {game} installations detected. Pass --game-path to select one."
msgstr "{game}のインストールが複数見つかりました。--game-path で1つ選んでください。"

#: src/cli.rs
#, rust-format
msgid ""
"No mod selection specified. Pass --all-mods, --preset <name>, or --mods <slug1,slug2>.\n"
"Use 'list-mods --game {game}' to see available mods and presets."
msgstr ""
"Modが選ばれていません。--all-mods、--preset <name>、--mods <slug1,slug2> のどれかを指定してください。\n"
"使えるModとプリセットは「list-mods --game {game}」で確認できます。"

#: src/cli.rs
#, rust-format
msgid "Library folders file not found: {path}"
msgstr "ライブラリフォルダーのファイルが見つかりません：{path}"

#: src/cli.rs
#, rust-format
msgid "{game} was not detected. Pass --game-path."
msgstr "{game}が見つかりません。--game-path を指定してください。"

#: src/cli.rs
#, rust-format
msgid "{game} is in a Steam library that cannot be accessed: {paths}. Mount the drive, or grant access to it in the Adventure Mods window, or pass --steam-library or --game-path."
msgstr "{game}はアクセスできないSteamライブラリにあります：{paths}。ドライブをマウントするか、Adventure Modsのウィンドウでアクセスを許可するか、--steam-library か --game-path を指定してください。"

#: src/cli.rs
#, rust-format
msgid "Unknown game '{game}'. Use 'sadx' or 'sa2'."
msgstr "不明なゲーム「{game}」です。「sadx」か「sa2」を使ってください。"

#: src/external/proton.rs
#, rust-format
msgid "{game} is ready for Proton. You can continue."
msgstr "{game}はProtonの準備ができています。続けられます。"

#: src/external/proton.rs
#, rust-format
msgid "Steam hasn't set up {game} for Proton yet. In Steam, force Proton 10.0 in Properties → Compatibility, launch the game once and wait for it to start, then close it and try again."
msgstr "Steamがまだ{game}をProton用に準備していません。Steamでプロパティ → 互換性を開いてProton 10.0を強制し、ゲームを一度起動して始まるまで待ち、閉じてから、もう一度お試しください。"

#: src/external/proton.rs
#, rust-format
msgid "Steam's Proton files for {game} are incomplete. Force Proton 10.0 if needed, launch the game once from Steam so it can repair them, then try again."
msgstr "{game}のProtonのファイルが不完全です。必要ならProton 10.0を強制し、Steamからゲームを一度起動して修復させてから、もう一度お試しください。"

#: src/external/proton.rs
#, rust-format
msgid "Adventure Mods couldn't read which Proton version Steam uses for {game}. In Steam, force Proton 10.0 in Properties → Compatibility, launch the game once, then try again."
msgstr "Adventure Modsは、Steamが{game}に使うProtonのバージョンを読み取れませんでした。Steamでプロパティ → 互換性を開いてProton 10.0を強制し、ゲームを一度起動してから、もう一度お試しください。"

#: src/external/proton.rs
#, rust-format
msgid "{game} is set to use {tool_name}, but it isn't installed. In Steam, install Proton 10.0 and force it for this game, launch the game once, then try again."
msgstr "{game}は{tool_name}を使う設定ですが、インストールされていません。SteamでProton 10.0をインストールしてこのゲームに強制し、ゲームを一度起動してから、もう一度お試しください。"

#: src/external/proton.rs
#, rust-format
msgid "{game} was last run with {prefix_tool}, but Steam now uses {configured_tool}. Launch the game once from Steam so it can update, then try again."
msgstr "{game}は前回{prefix_tool}で起動されましたが、Steamは今{configured_tool}を使っています。Steamからゲームを一度起動して更新させてから、もう一度お試しください。"

#: src/external/proton.rs
#, rust-format
msgid "Steam is set to run {game} with {tool_name} (version {major}), which can't run SA Mod Manager. In Steam, force Proton 10.0 in Properties → Compatibility, launch the game once, close it, then try again."
msgstr "Steamは{game}を{tool_name}（バージョン{major}）で起動するよう設定されていますが、これではSA Mod Managerを実行できません。Steamでプロパティ → 互換性を開いてProton 10.0を強制し、ゲームを一度起動して閉じてから、もう一度お試しください。"

#: src/external/proton.rs
#, rust-format
msgid "{game} was last run with {tool_name} (version {major}). SA Mod Manager doesn't start on Proton 11 or newer, including Hotfix, Experimental and many custom builds. In Steam, force Proton 10.0 in Properties → Compatibility, launch the game once, close it, then try again."
msgstr "{game}は前回{tool_name}（バージョン{major}）で起動されました。SA Mod ManagerはProton 11以降では起動しません。Hotfix、Experimental、多くのカスタムビルドも同じです。Steamでプロパティ → 互換性を開いてProton 10.0を強制し、ゲームを一度起動して閉じてから、もう一度お試しください。"

#: src/external/proton.rs
#, rust-format
msgid "{game} is set to use {tool_name}, and Adventure Mods can't tell which Proton version it is. SA Mod Manager needs Proton 10.0 and doesn't start on Proton 11 or newer. If this isn't Proton 10.0, force Proton 10.0 in Properties → Compatibility, launch the game once, close it, then continue."
msgstr "{game}は{tool_name}を使う設定ですが、Adventure ModsにはそれがどのProtonのバージョンか分かりません。SA Mod ManagerにはProton 10.0が必要で、Proton 11以降では起動しません。Proton 10.0でない場合は、プロパティ → 互換性でProton 10.0を強制し、ゲームを一度起動して閉じてから、続けてください。"

#: src/external/proton.rs src/setup/steps.rs
#, rust-format
msgid "In Steam, open {game}'s Properties → Compatibility and force Proton 10.0. Launch the game once, close it, then try again."
msgstr "Steamで、{game}のプロパティ → 互換性を開いてProton 10.0を強制してください。ゲームを一度起動して閉じてから、もう一度お試しください。"

#: src/main.rs
#, rust-format
msgid "Could not open the window: {error}"
msgstr "ウィンドウを開けませんでした：{error}"

#: src/setup/config.rs
#, rust-format
msgid "Unknown subtitle language '{value}'"
msgstr "不明な字幕の言語「{value}」です"

#: src/setup/config.rs
#, rust-format
msgid "Unknown voice language '{value}'"
msgstr "不明な音声の言語「{value}」です"

#: src/setup/pipeline.rs
#, rust-format
msgid "Failed to install mods: {mods}"
msgstr "Modをインストールできませんでした：{mods}"

#: src/setup/pipeline.rs
#, rust-format
msgid "Unknown mod '{name}' for {game}"
msgstr "{game}に不明なMod「{name}」があります"

#: src/setup/pipeline.rs
#, rust-format
msgid "Unknown preset '{name}' for {game}"
msgstr "{game}に不明なプリセット「{name}」があります"

#: src/setup/restore.rs
#, rust-format
msgid "Restored {file}"
msgstr "{file} を元に戻しました"

#: src/setup/restore.rs
#, rust-format
msgid "Removed {file}"
msgstr "{file} を削除しました"

#: src/setup/restore.rs
msgid "Removed the mod loader"
msgstr "Modローダーを削除しました"

#: src/setup/sa2_catalog.rs
msgid "Fixes many graphics bugs and brings back Dreamcast visuals."
msgstr "多くのグラフィックの不具合を直し、ドリームキャストの見た目を戻します。"

#: src/setup/sa2_catalog.rs
msgid "Fixes many graphics bugs in the PC version, like see-through objects drawn in the wrong order and missing effects. It also brings back details from the Dreamcast version, such as shine on shiny surfaces and the original textures and lighting."
msgstr "PC版の多くのグラフィックの不具合を直します。たとえば、透明な物が間違った順番で描かれる問題や、抜けているエフェクトなどです。光る面の反射や、元のテクスチャーとライティングなど、ドリームキャスト版の細部も戻します。"

#: src/setup/sa2_catalog.rs
msgid "A big Chao World overhaul."
msgstr "チャオワールドを大きく作り直します。"

#: src/setup/sa2_catalog.rs
msgid "Overhauls Chao World with redesigned gardens, a better camera, a menu to customize your Chao, a market, teleporting between gardens and many bug fixes. Almost every feature can be turned off in the mod's settings."
msgstr "チャオワールドを作り直します。ガーデンのデザインが新しくなり、カメラが良くなり、チャオをカスタマイズするメニュー、お店、ガーデン間のワープ、多くの不具合の修正が加わります。ほとんどの機能はModの設定でオフにできます。"

#: src/setup/sa2_catalog.rs
msgid "Extra options for Render Fix's cutscenes."
msgstr "Render Fixのムービーに追加の設定を加えます。"

#: src/setup/sa2_catalog.rs
msgid "Adds options to Render Fix's Dreamcast cutscenes: Sonic's shoes from The Trial, Amy's eyeliner, retimed voice lines and The Trial's opening music. They all start off, so turn on the ones you want in the mod's settings."
msgstr "Render Fixのドリームキャスト版ムービーに設定を追加します。The Trialのソニックの靴、エミーのアイライン、タイミングを直したセリフ、The Trialのオープニング曲です。最初はすべてオフなので、使いたいものをModの設定でオンにしてください。"

#: src/setup/sa2_catalog.rs
msgid "Sharper menus, HUD and icons."
msgstr "メニュー、HUD、アイコンがくっきりします。"

#: src/setup/sa2_catalog.rs
msgid "Replaces blurry HUD, menu, item box and logo graphics with sharper versions that stay close to the originals. It adjusts itself when the Battle DLC is on or off. Chao World, 2-player mode and the credits keep the original graphics."
msgstr "HUD、メニュー、アイテムボックス、ロゴのぼやけた画像を、元に忠実でくっきりした画像に置き換えます。Battle DLCが有効かどうかに合わせて自動で切り替わります。チャオワールド、2人プレイ、エンディングのスタッフロールは元の画像のままです。"

#: src/setup/sa2_catalog.rs
msgid "Swaps the game's font for the rounder 'Impress' font."
msgstr "ゲームのフォントを、丸みのある「Impress」フォントに置き換えます。"

#: src/setup/sa2_catalog.rs
msgid "Replaces the game's Comic Sans-like font with the 'Impress' font from the Japanese version. It works with English, French, German, Spanish and Italian text."
msgstr "Comic Sansに似たゲームのフォントを、日本版の「Impress」フォントに置き換えます。英語、フランス語、ドイツ語、スペイン語、イタリア語のテキストで使えます。"

#: src/setup/sa2_catalog.rs
msgid "Separate volume for music, sound effects and voices."
msgstr "音楽、効果音、音声の音量を別々に調整できます。"

#: src/setup/sa2_catalog.rs
msgid "Lets you set the volume of music, sound effects, voices and cutscenes separately. The default mix matches the Dreamcast version. It also fixes several sound bugs and can play sounds from the side they come from."
msgstr "音楽、効果音、音声、ムービーの音量を別々に調整できます。標準の音量バランスはドリームキャスト版と同じです。いくつかの音の不具合も直し、音が鳴った方向から聞こえるようにもできます。"

#: src/setup/sa2_catalog.rs
msgid "Quieter mech footsteps and a softer targeting sound."
msgstr "メカの足音を静かにし、照準の音をやわらかくします。"

#: src/setup/sa2_catalog.rs
msgid "Makes Tails' and Eggman's mech stages easier on the ears. Footsteps are quieter, the constant targeting whine is nearly gone, and locking on has a crisper sound."
msgstr "テイルスとエッグマンのメカのステージを聞きやすくします。足音が静かになり、照準のブーンという音がほぼ消え、ロックオンの音がはっきりします。"

#: src/setup/sa2_catalog.rs
msgid "A helper other mods need. It does nothing on its own."
msgstr "ほかのModが必要とするツールです。単体では何もしません。"

#: src/setup/sa2_catalog.rs
msgid "Lets other mods use the SDL2 library without clashing with each other. It does nothing by itself, but SA2 Input Controls needs it."
msgstr "ほかのModがSDL2ライブラリをぶつからずに使えるようにします。単体では何もしませんが、SA2 Input Controlsに必要です。"

#: src/setup/sa2_catalog.rs
msgid "Smoother analog controls and easier rail grinding."
msgstr "なめらかなアナログ操作と、楽なグラインド。"

#: src/setup/sa2_catalog.rs
msgid "Rewrites the game's controls. The analog stick moves smoothly in every direction instead of sticking to 8 directions, and rail grinding is much easier. Most controllers work right away, and every keyboard key can be changed."
msgstr "ゲームの操作を作り直します。アナログスティックが8方向に固定されず、どの方向にもなめらかに動き、レールのグラインドがずっと楽になります。ほとんどのコントローラーがそのまま使え、キーボードのキーはすべて変更できます。"

#: src/setup/sa2_catalog.rs
msgid "The treasure radar tracks all three pieces at once."
msgstr "宝探しのレーダーが3つのかけらを同時に追います。"

#: src/setup/sa2_catalog.rs
msgid "Upgrades the radar in treasure-hunting stages. It tracks all three pieces at the same time, adds blue and pink indicators and a sound for each piece, and its animation speeds up with the beeps. Each change can be turned off."
msgstr "宝探しステージのレーダーを改良します。3つのかけらを同時に追い、かけらごとに青とピンクの表示と音を追加し、ビープ音に合わせてアニメーションが速くなります。変更はそれぞれオフにできます。"

#: src/setup/sa2_catalog.rs
msgid "Small tweaks that make Sonic and Shadow feel smoother."
msgstr "ソニックとシャドウをなめらかに操作できる小さな調整です。"

#: src/setup/sa2_catalog.rs
msgid "Sonic keeps his speed in somersaults, you no longer slow down by falling off rails, and Light Attacks bounce you up like Homing Attacks. Homing Attack bounces are never too low, and the Magic Hands prompt shows up by itself. Each tweak can be turned off."
msgstr "宙返り中もソニックの勢いが落ちず、レールから落ちても減速しなくなり、ライトアタックでもホーミングアタックのように上に跳ね返ります。ホーミングアタックの跳ね返りが低くなりすぎることはなく、マジックハンドのヒントも自動で出ます。調整はそれぞれオフにできます。"

#: src/setup/sa2_catalog.rs
msgid "Objects and levels stay visible farther away."
msgstr "物やステージが遠くまで見えるようになります。"

#: src/setup/sa2_catalog.rs
msgid "Draws objects and level parts 5 times farther away than before. If the game slows down or enemies act strangely in the distance, turn on Clip object logic in the mod's settings."
msgstr "物やステージの一部を今までの5倍遠くまで描きます。ゲームが重くなったり、遠くの敵の動きがおかしくなったりしたら、Modの設定でClip object logicをオンにしてください。"

#: src/setup/sa2_catalog.rs
msgid "Fixes odd mistakes in the levels."
msgstr "ステージのおかしなミスを直します。"

#: src/setup/sa2_catalog.rs
msgid "Fixes small mistakes in the levels, like missing or broken Gold Beetles and out-of-bounds Rings that make the automatic A-Rank impossible. It also fixes mistakes in the English and Spanish hints of the hunting levels."
msgstr "ステージの小さなミスを直します。たとえば、ないか動かないゴールドビートルや、場外にあって自動でAランクを取れなくするリングです。宝探しステージの英語とスペイン語のヒントの間違いも直します。"

#: src/setup/sa2_catalog.rs
msgid "A new English story translation, closer to the Japanese script."
msgstr "日本語の台本に近い、新しいストーリーの英語訳です。"

#: src/setup/sa2_catalog.rs
msgid "Replaces the English story text with a translation closer to the original Japanese script, based on Windii's subtitles. It also adds subtitles to videos and voice lines that had none."
msgstr "ストーリーの英語テキストを、Windiiさんの字幕をもとにした、元の日本語の台本に近い翻訳に置き換えます。字幕がなかった動画やセリフにも字幕を追加します。"

#: src/setup/sa2_catalog.rs
msgid "Fixes the hints in treasure-hunting stages."
msgstr "宝探しステージのヒントを直します。"

#: src/setup/sa2_catalog.rs
msgid "Retranslates the treasure-hunting hints from the Japanese text. Wrong areas, missing details and typos are fixed, and the hints use the same area names as Omochao."
msgstr "宝探しのヒントを日本語のテキストから訳し直します。間違った場所、抜けている情報、誤字が直り、ヒントはオモチャオと同じ場所の名前を使います。"

#: src/setup/sa2_catalog.rs
msgid "New moves for Sonic and remappable actions."
msgstr "ソニックの新しい技と、割り当てを変えられるアクション。"

#: src/setup/sa2_catalog.rs
msgid "Adds the SA1 Spin Dash, a faster and higher Bounce, and more attacks that break boxes. Shadow can use Bounce too. You can put Light Dash, Bounce, Somersault and Spin Dash on B, X or Y, and speed characters can finish most Tails and Eggman stages."
msgstr "SA1のスピンダッシュ、より速く高いバウンド、箱を壊せる攻撃を増やします。シャドウもバウンドを使えます。ライトダッシュ、バウンド、宙返り、スピンダッシュをB、X、Yに割り当てられ、スピードタイプのキャラでもテイルスとエッグマンのほとんどのステージをクリアできます。"

#: src/setup/sadx.rs
#, rust-format
msgid ""
"Steam-to-2004 conversion failed. Your game installation might be modified or corrupted. Please verify game integrity in Steam and try again.\n"
"\n"
"Details:\n"
"{stderr}"
msgstr ""
"2004年版への変換に失敗しました。インストールが改変されているか、壊れている可能性があります。Steamでゲームファイルの整合性を確認してから、もう一度お試しください。\n"
"\n"
"詳細：\n"
"{stderr}"

#: src/setup/sadx_catalog.rs
msgid "Brings back the Dreamcast version's look."
msgstr "ドリームキャスト版の見た目を戻します。"

#: src/setup/sadx_catalog.rs
msgid "Brings back levels, textures, object models, special effects and branding from the Dreamcast version, so the game looks like the original Sonic Adventure. While paused, X+Y hides the pause menu."
msgstr "ドリームキャスト版のステージ、テクスチャー、物のモデル、特殊効果、ロゴを戻し、元のソニックアドベンチャーのような見た目にします。ポーズ中にX+Yでポーズメニューを隠せます。"

#: src/setup/sadx_catalog.rs
msgid "Fixes many bugs in the PC version."
msgstr "PC版の多くのバグを直します。"

#: src/setup/sadx_catalog.rs
msgid "Fixes misplaced items and objects, broken level geometry and game logic errors in the PC version."
msgstr "PC版の置き場所がおかしい物、壊れたステージの形、ゲームの処理の間違いを直します。"

#: src/setup/sadx_catalog.rs
msgid "Dreamcast-style lighting."
msgstr "ドリームキャスト風のライティング。"

#: src/setup/sadx_catalog.rs
msgid "Brings back the palette-based lighting of the Dreamcast version, so characters and levels are lit the way they were on Dreamcast."
msgstr "ドリームキャスト版のパレットを使ったライティングを戻し、キャラクターとステージをドリームキャストと同じように照らします。"

#: src/setup/sadx_catalog.rs
msgid "Unlock Steam achievements while using mods."
msgstr "Modを入れてもSteamの実績を解除できます。"

#: src/setup/sadx_catalog.rs
msgid "Setup turns the Steam version into the 2004 version, which has no Steam achievements. This mod brings back all 15."
msgstr "セットアップでSteam版を、Steamの実績がない2004年版に変えます。このModで15個の実績がすべて戻ります。"

#: src/setup/sadx_catalog.rs
msgid "Smoother first-person view."
msgstr "なめらかな一人称視点。"

#: src/setup/sadx_catalog.rs
msgid "Makes looking around in first-person view with the right stick smooth. It also inverts up and down on the right stick."
msgstr "右スティックでの一人称視点の見回しをなめらかにします。右スティックの上下も反転します。"

#: src/setup/sadx_catalog.rs
msgid "A steadier frame rate."
msgstr "安定したフレームレート。"

#: src/setup/sadx_catalog.rs
msgid "A more precise frame limiter. It reduces stutter and fixes the game getting stuck at about 63 FPS, using a bit more CPU."
msgstr "より正確なフレームレート制限です。カクつきを減らし、ゲームが63 FPSあたりで止まってしまうのを防ぎます。そのぶんCPUを少し多く使います。"

#: src/setup/sadx_catalog.rs
msgid "Better sound effects from the Dreamcast version."
msgstr "ドリームキャスト版の、より良い効果音。"

#: src/setup/sadx_catalog.rs
msgid "Replaces almost all sound effects with higher-quality versions from the Dreamcast version, and fixes several sound bugs."
msgstr "ほぼすべての効果音を、ドリームキャスト版の高品質なものに置き換え、いくつかの音の不具合を直します。"

#: src/setup/sadx_catalog.rs
msgid "Brings back the ocean waves in Emerald Coast."
msgstr "エメラルドコーストに海の波を戻します。"

#: src/setup/sadx_catalog.rs
msgid "Changes some water textures and brings back the ocean wave effect in Emerald Coast, which the GameCube version and later ports removed."
msgstr "一部の水のテクスチャーを変え、ゲームキューブ版以降の移植でなくなったエメラルドコーストの波のエフェクトを戻します。"

#: src/setup/sadx_catalog.rs
msgid "Motion blur trails from the original game."
msgstr "元のゲームの残像エフェクト。"

#: src/setup/sadx_catalog.rs
msgid "Brings back the blur trail behind Sonic and Knuckles when they run, and behind Tails' tails, from the original Sonic Adventure."
msgstr "元のソニックアドベンチャーにあった、走るソニックとナックルズの後ろと、テイルスのしっぽの後ろの残像を戻します。"

#: src/setup/sadx_catalog.rs
msgid "The original Dreamcast character models."
msgstr "ドリームキャスト版の元のキャラクターモデル。"

#: src/setup/sadx_catalog.rs
msgid "Replaces the DX character models with the original Dreamcast ones for Sonic, Tails, Knuckles, Amy, Big and Super Sonic. Tikal gets her original hands, E-102 his original materials, and Eggman is partly restored."
msgstr "DXのキャラクターモデルを、ソニック、テイルス、ナックルズ、エミー、ビッグ、スーパーソニックのドリームキャスト版の元のモデルに置き換えます。ティカルは元の手に、E-102は元の素材に戻り、エッグマンも一部戻ります。"

#: src/setup/sadx_catalog.rs
msgid "Improved DX character models."
msgstr "改良されたDXのキャラクターモデル。"

#: src/setup/sadx_catalog.rs
msgid "Improves the DX character models instead of replacing them, with better shapes, textures and effects. It also fixes over 200 broken animations for Sonic, Tails, Knuckles, Amy and Big."
msgstr "DXのキャラクターモデルを置き換えずに改良し、形、テクスチャー、エフェクトを良くします。ソニック、テイルス、ナックルズ、エミー、ビッグの壊れたアニメーションも200個以上直します。"

#: src/setup/sadx_catalog.rs
msgid "The Dreamcast version's downloadable events."
msgstr "ドリームキャスト版のダウンロードイベント。"

#: src/setup/sadx_catalog.rs
msgid "Brings back the holiday events and other downloadable content from the Dreamcast version. It can also play the SEGA and Sonic Team voices on the logo screens."
msgstr "ドリームキャスト版の季節のイベントや、そのほかのダウンロードコンテンツを戻します。ロゴ画面でSEGAとソニックチームのボイスを流すこともできます。"

#: src/setup/sadx_catalog.rs
msgid "Press Z to hear your character talk about the stage."
msgstr "Zを押すと、キャラクターがステージについて話します。"

#: src/setup/sadx_catalog.rs
msgid "Press Z to hear what your character has to say about the stage whenever you want, instead of waiting for it."
msgstr "Zを押すと、待たずにいつでもキャラクターがステージについて話すのを聞けます。"

#: src/setup/sadx_catalog.rs
msgid "Press X+Y to hide the pause menu."
msgstr "X+Yでポーズメニューを隠します。"

#: src/setup/sadx_catalog.rs
msgid "While paused, press X+Y to hide the pause menu and take clean screenshots, like on Dreamcast. Dreamcast Conversion already does this, so you don't need both."
msgstr "ポーズ中にX+Yを押すと、ドリームキャストのようにポーズメニューを隠して、きれいなスクリーンショットを撮れます。Dreamcast Conversionにもこの機能があるので、両方は必要ありません。"

#: src/setup/sadx_catalog.rs
msgid "Take the train to change the time of day."
msgstr "列車に乗ると時間帯が変わります。"

#: src/setup/sadx_catalog.rs
msgid "After you finish the story, taking the train between Station Square and the Mystic Ruins changes the time of day."
msgstr "ストーリーをクリアしたあと、ステーションスクエアとミスティックルーインの間を列車で移動すると時間帯が変わります。"

#: src/setup/sadx_catalog.rs
msgid "A translation closer to the Japanese script."
msgstr "日本語の台本に近い翻訳です。"

#: src/setup/sadx_catalog.rs
msgid "Replaces the English story text with Windii's translation, which follows the original Japanese script closely."
msgstr "ストーリーの英語テキストを、元の日本語の台本に忠実なWindiiさんの翻訳に置き換えます。"

#: src/setup/sadx_catalog.rs
msgid "A score counter and more on the HUD."
msgstr "HUDにスコアの表示などを追加します。"

#: src/setup/sadx_catalog.rs
msgid "Adds a score counter, shows the Chao animals you've collected in the pause menu, and lets the ring and life counters show numbers past their old limit."
msgstr "スコアの表示を追加し、集めたチャオ用の動物をポーズメニューに表示し、リングとライフの表示で以前の上限を超える数を出せるようにします。"

#: src/setup/sadx_catalog.rs
msgid "Sharper menus and HUD."
msgstr "くっきりしたメニューとHUD。"

#: src/setup/sadx_catalog.rs
msgid "High-resolution textures for most menus and on-screen icons, made for 720p and higher."
msgstr "ほとんどのメニューと画面上のアイコンの高解像度テクスチャーです。720p以上向けです。"

#: src/setup/sadx_catalog.rs
msgid "Faces move while characters talk."
msgstr "キャラクターが話すと顔が動きます。"

#: src/setup/sadx_catalog.rs
msgid "Characters move their mouths and faces when they talk or react during gameplay, not just in cutscenes. This includes being underwater, dying and, for Sonic and Tails, clearing a stage."
msgstr "ムービーだけでなくゲーム中も、キャラクターが話したり反応したりすると口と顔が動きます。水中にいるとき、やられたとき、ソニックとテイルスがステージをクリアしたときも含みます。"

#: src/setup/sadx_catalog.rs
msgid "New moves for Tails, Knuckles and Amy."
msgstr "テイルス、ナックルズ、エミーの新しい技。"

#: src/setup/sadx_catalog.rs
msgid "Tails can grab and carry friends while flying. Tails and Knuckles can Spin Dash with B. Knuckles can drill down and dig into walls, and Amy gets a hammer propeller and a double jump. Each move can be turned off."
msgstr "テイルスは飛びながら仲間をつかんで運べます。テイルスとナックルズはBでスピンダッシュができます。ナックルズは地面に急降下したり壁に潜ったりでき、エミーはハンマーでのプロペラと二段ジャンプを使えます。技はそれぞれオフにできます。"

#: src/setup/sadx_catalog.rs
msgid "Tails follows you in more places and helps out."
msgstr "テイルスがより多くの場所でついてきて手伝います。"

#: src/setup/sadx_catalog.rs
msgid "Tails follows Sonic into the hub worlds, Chao Gardens and most boss fights, rides vehicles with him, and pets Chao with you. He flies faster to keep up, and he can fly you around the hub worlds."
msgstr "テイルスがアドベンチャーフィールド、チャオガーデン、ほとんどのボス戦でソニックについてきて、乗り物にも一緒に乗り、一緒にチャオをなでます。遅れないよう速く飛び、アドベンチャーフィールドではあなたを運んで飛ぶこともできます。"

#: src/setup/sadx_catalog.rs
msgid "Play as Super Sonic in action stages."
msgstr "アクションステージでスーパーソニックを使えます。"

#: src/setup/sadx_catalog.rs
msgid "After you finish the Super Sonic story, jump and press the action button with 50 rings or more to turn into Super Sonic in any stage. Super Sonic can use all of Sonic's moves."
msgstr "スーパーソニックのストーリーをクリアしたあと、リングが50個以上あるときにジャンプしてアクションボタンを押すと、どのステージでもスーパーソニックになれます。スーパーソニックはソニックの技をすべて使えます。"

#: src/setup/sadx_catalog.rs
msgid "Take your Chao into stages."
msgstr "チャオをステージに連れて行けます。"

#: src/setup/sadx_catalog.rs
msgid "Hold a Chao as you leave its garden and it follows you through stages and hub worlds, attacking nearby enemies based on its stats. You can drop it anytime."
msgstr "チャオを抱えたままガーデンを出ると、ステージやアドベンチャーフィールドでついてきて、能力に応じて近くの敵を攻撃します。いつでも降ろせます。"

#: src/setup/sadx_catalog.rs
msgid "Optional extras and beta content."
msgstr "追加のおまけとベータ版の要素。"

#: src/setup/sadx_catalog.rs
msgid "A set of optional extras: unused voice lines and sound effects, beta objects and effects, and fixes for some cutscenes and objects. Each one can be turned on or off."
msgstr "追加のおまけをまとめたものです。使われなかったセリフや効果音、ベータ版の物やエフェクト、一部のムービーや物の修正が入っています。それぞれオンとオフを切り替えられます。"

#: src/setup/sadx_catalog.rs
msgid "Smoother, better-timed cutscenes."
msgstr "ムービーがなめらかになり、タイミングも良くなります。"

#: src/setup/sadx_catalog.rs
msgid "Fixes awkward pauses, bad timing, missing lip sync and characters moving the wrong way in the story cutscenes. Red Mountain's ending cutscene needs Fixes, Adds, and Beta Restores."
msgstr "ストーリーのムービーで、不自然な間、ずれたタイミング、動かない口、間違った方向に動くキャラクターを直します。レッドマウンテンの最後のムービーにはFixes, Adds, and Beta Restoresが必要です。"

#: src/setup/sadx_catalog.rs
msgid "Subtitles for voice lines that had none."
msgstr "字幕のなかったセリフに字幕を付けます。"

#: src/setup/sadx_catalog.rs
msgid "Shows subtitles for most voice lines that had no text, like character select, idle chatter, announcers, bosses and Sky Chase. It has text for every game language, including an English set that matches the retranslation."
msgstr "キャラクター選択、待機中のセリフ、アナウンス、ボス、スカイチェイスなど、字幕のなかったほとんどのセリフに字幕を表示します。ゲームのすべての言語に対応し、英語には再翻訳に合わせたものもあります。"

#: src/setup/sadx_catalog.rs
msgid "Swaps the two songs of the final boss fight."
msgstr "最終決戦の2曲を入れ替えます。"

#: src/setup/sadx_catalog.rs
msgid "Swaps the two music tracks of the Perfect Chaos fight, so Open Your Heart plays at the end instead of the start."
msgstr "パーフェクトカオス戦の2曲を入れ替え、Open Your Heartが最初ではなく最後に流れるようにします。"

#: src/setup/sadx_catalog.rs
msgid "Upscaled 1080p videos."
msgstr "1080pにアップスケールした動画。"

#: src/setup/sadx_catalog.rs
msgid "Replaces the intro and cutscene videos with versions upscaled to 1080p."
msgstr "オープニングとムービーの動画を、1080pにアップスケールしたものに置き換えます。"

#: src/setup/sadx_catalog.rs
msgid "Sharper, AI-upscaled textures."
msgstr "AIでアップスケールした、くっきりしたテクスチャー。"

#: src/setup/sadx_catalog.rs
msgid "Textures for almost the whole game, upscaled with AI for high-resolution screens. It has a version for Dreamcast Conversion and one for the original game."
msgstr "ゲームのほぼすべてのテクスチャーを、高解像度の画面向けにAIでアップスケールしたものです。Dreamcast Conversion用と元のゲーム用があります。"

#: src/setup/sadx_catalog.rs
msgid "Local split-screen for up to 4 players."
msgstr "最大4人のローカル画面分割。"

#: src/setup/sadx_catalog.rs
msgid "Adds local split-screen for up to 4 players in co-op and battle modes on trial stages, including fishing, treasure hunting and shooting."
msgstr "アクションステージに、協力と対戦の最大4人のローカル画面分割を追加します。釣り、宝探し、シューティングにも対応します。"

#: src/setup/sadx_catalog.rs
msgid "Dreamcast levels and lighting with the improved DX characters and DX-style water, plus HD textures, videos and menus, and extra gameplay mods."
msgstr "ドリームキャストのステージとライティングに、改良されたDXのキャラクターとDX風の水、さらにHDのテクスチャー、動画、メニューと、追加のゲームプレイModを組み合わせます。"

#: src/setup/sadx_catalog.rs
msgid "Dreamcast levels and lighting with the original Dreamcast characters, plus HD textures, videos and menus, and extra gameplay mods."
msgstr "ドリームキャストのステージとライティングに、ドリームキャスト版の元のキャラクター、さらにHDのテクスチャー、動画、メニューと、追加のゲームプレイModを組み合わせます。"

#: src/setup/steps.rs
