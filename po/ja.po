msgstr ".NETランタイムをインストール"

#: src/setup/steps.rs
msgid "Convert to the 2004 Version"
msgstr "2004年版に変換"

#: src/setup/steps.rs
msgid "Install Mod Manager & Loader"
msgstr "Modマネージャーとローダーをインストール"

#: src/setup/steps.rs
msgid "Install Mods"
msgstr "Modをインストール"

#: src/setup/steps.rs
msgid "Set Up Proton"
msgstr "Protonの設定"

#: src/setup/steps.rs
msgid "Choose Mods"
msgstr "Modを選ぶ"

#: src/setup/steps.rs
msgid "Pick a preset or choose mods one by one."
msgstr "プリセットを選ぶか、Modを1つずつ選んでください。"

#: src/setup/steps.rs
msgid "Languages"
msgstr "言語"

#: src/setup/steps.rs
msgid "Choose the languages for subtitles and voices."
msgstr "字幕と音声の言語を選んでください。"

#: src/setup/steps.rs
msgid ".NET Runtimes"
msgstr ".NETランタイム"

#: src/setup/steps.rs
msgid "Versions 8 and 10, installed or updated"
msgstr "バージョン8と10をインストールまたは更新"

#: src/setup/steps.rs
msgid "2004 Version"
msgstr "2004年版"

#: src/setup/steps.rs
msgid "The Steam version, converted so mods can load"
msgstr "Modを読み込めるように変換したSteam版"

#: src/setup/steps.rs
msgid "Mod Manager and Loader"
msgstr "Modマネージャーとローダー"

#: src/setup/steps.rs
msgid "Installed or updated to the latest release"
msgstr "最新版をインストールまたは更新"

#: src/setup/steps.rs
msgid "Mods"
msgstr "Mod"

#: src/setup/steps.rs
msgid "Downloaded and set up with your choices"
msgstr "選んだ内容でダウンロードとセットアップ済み"

#: src/setup/steps.rs
msgid "Ready to Play"
msgstr "準備完了"

#: src/setup/steps.rs
#, rust-format
msgid "Start {game} from Steam. The mod manager opens first, so you can turn mods on or off before playing."
msgstr "Steamから{game}を起動してください。最初にModマネージャーが開くので、遊ぶ前にModをオン・オフできます。"

#: src/ui/app.rs
#, rust-format
msgid "Failed to detect Steam libraries: {error}"
msgstr "Steamライブラリを見つけられませんでした：{error}"

#: src/ui/app.rs
#, rust-format
msgid "That folder is not the requested Steam library. Select {path} (it must contain a steamapps folder)."
msgstr "このフォルダーは求めているSteamライブラリではありません。{path} を選んでください（steamapps フォルダーが入っている必要があります）。"

#: src/ui/app.rs
#, rust-format
msgid "{game} was restored."
msgstr "{game}を元に戻しました。"

#: src/ui/app.rs
#, rust-format
msgid "Could not restore {game}: {error}"
msgstr "{game}を元に戻せませんでした：{error}"

#: src/ui/app.rs
msgid "About"
msgstr "このアプリについて"

#: src/ui/app.rs
msgid "Scan Again"
msgstr "もう一度探す"

#: src/ui/app.rs
msgid "Select"
msgstr "決定"

#: src/ui/app.rs src/ui/widgets.rs
msgid "Back"
msgstr "戻る"

#: src/ui/app.rs
#, rust-format
msgid "Restore the original {game}?"
msgstr "{game}を元に戻しますか？"

#: src/ui/app.rs
msgid "This puts back the game's original launcher and removes the mod loader, so Steam starts the unmodded game. Downloaded mods stay in the mods folder and are reused if you set the game up again."
msgstr "ゲームの元のランチャーを戻してModローダーを削除し、SteamがModなしのゲームを起動するようにします。ダウンロードしたModは mods フォルダーに残り、もう一度セットアップするときに再利用されます。"

#: src/ui/app.rs src/ui/dialogs.rs src/ui/setup.rs
msgid "Cancel"
msgstr "キャンセル"

#: src/ui/app.rs src/ui/welcome.rs
msgid "Restore"
msgstr "元に戻す"

#: src/ui/app.rs
msgid "Finish in Steam"
msgstr "Steamで仕上げる"

#: src/ui/app.rs
#, rust-format
msgid "Setup converted {game} to the 2004 version. Let Steam verify the game files to get the original Steam version back."
msgstr "セットアップで{game}を2004年版に変換しました。Steamでゲームファイルの整合性を確認すると、元のSteam版に戻ります。"

#: src/ui/app.rs
msgid "Later"
msgstr "あとで"

#: src/ui/app.rs src/ui/welcome.rs
msgid "Verify in Steam"
msgstr "Steamで確認"

#: src/ui/app.rs
msgid "The easiest way to mod Sonic Adventure DX and Sonic Adventure 2 on Linux."
msgstr "LinuxでSonic Adventure DXとSonic Adventure 2にModを入れるいちばん簡単な方法です。"

#: src/ui/app.rs
msgid "Report an Issue"
msgstr "問題を報告"

#: src/ui/app.rs
msgid "Close"
msgstr "閉じる"

#. Translators: {heart} is a red heart.
#: src/ui/app.rs
#, rust-format
msgid "Made with {heart} by astro"
msgstr "astroが{heart}を込めて作りました"

#: src/ui/mod.rs
msgid "Grant access to a Steam library"
msgstr "Steamライブラリへのアクセスを許可"

#: src/ui/progress.rs
#, rust-format
msgid "Saving settings… ({total}/{total})"
msgstr "設定を保存しています…（{total}/{total}）"

#: src/ui/progress.rs
#, rust-format
msgid "Downloading {name} - {progress}"
msgstr "{name}をダウンロード中 - {progress}"

#: src/ui/progress.rs
#, rust-format
msgid "Downloading {n} mod - {progress}"
msgid_plural "Downloading {n} mods - {progress}"
msgstr[0] "{n}個のModをダウンロード中 - {progress}"

#: src/ui/progress.rs
#, rust-format
msgid "Retrying {name} (attempt {attempt} of {max})…"
msgstr "{name}を再試行中（{attempt}/{max}回目）…"

#: src/ui/progress.rs
#, rust-format
msgid "Waiting for the server to send {name}… ({seconds} s)"
msgstr "{name}のサーバーを待っています…（{seconds} s）"

#: src/ui/progress.rs
