msgstr "{game}のインストール先を選んでください"

#: src/cli.rs
msgid "Cannot use both --preset and --mods at the same time"
msgstr "--preset と --mods は同時に使えません"

#: src/cli.rs
msgid "Cannot use --all-mods with --preset"
msgstr "--all-mods と --preset は同時に使えません"

#: src/cli.rs
msgid "Cannot use --all-mods with --mods"
msgstr "--all-mods と --mods は同時に使えません"

