msgstr "バージョン 8 と 10、インストール済みまたは更新済み"

#: src/setup/steps.rs:135
msgid "2004 Version"
msgstr "2004 版"

#: src/setup/steps.rs:136
msgid "Converts the Steam version for the mod loader"
msgstr "Mod ローダー用に Steam 版を変換します"

#: src/setup/steps.rs:144
msgid "Mod Manager and Loader"
msgstr "Mod Manager と Loader"

#: src/setup/steps.rs:145
