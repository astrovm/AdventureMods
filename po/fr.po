msgid "Multiple {game} installations detected. Pass --game-path to select one."
msgstr ""
"Plusieurs installations de {game} détectées. Passez --game-path pour en "
"choisir une."

#: src/cli.rs:1163
msgid ""
"No mod selection specified. Pass --all-mods, --preset <name>, or --mods "
"<slug1,slug2>.\n"
"Use 'list-mods --game {game}' to see available mods and presets."
msgstr ""
"Aucune sélection de mods indiquée. Passez --all-mods, --preset <nom> ou --"
"mods <slug1,slug2>.\n"
"Utilisez 'list-mods --game {game}' pour voir les mods et préréglages "
"disponibles."

