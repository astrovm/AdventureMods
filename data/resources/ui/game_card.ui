<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="AdventureModsGameCard" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="width-request">320</property>
    <property name="hexpand">false</property>
    <property name="halign">center</property>
    <property name="valign">start</property>
    <property name="overflow">hidden</property>
    <style>
      <class name="card"/>
      <class name="game-card"/>
    </style>
    <child>
      <!-- Covers are 460x215 Steam headers; the clamp keeps every card the same size. -->
      <object class="AdwClamp">
        <property name="maximum-size">320</property>
        <property name="tightening-threshold">320</property>
        <property name="child">
          <object class="GtkPicture" id="cover_picture">
            <property name="height-request">150</property>
            <property name="can-shrink">true</property>
            <property name="content-fit">cover</property>
            <style>
              <class name="game-card-cover"/>
            </style>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <property name="margin-top">14</property>
        <property name="margin-bottom">16</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkLabel" id="title_label">
                <property name="xalign">0</property>
                <property name="wrap">true</property>
                <style>
                  <class name="title-4"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="status_row">
                <property name="spacing">6</property>
                <child>
                  <object class="GtkImage" id="status_icon">
                    <property name="pixel-size">14</property>
                    <style>
                      <class name="game-card-status-icon"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="badge_label">
                    <property name="xalign">0</property>
                    <style>
                      <class name="game-card-badge"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="install_selector">
            <property name="visible">false</property>
            <property name="hexpand">true</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="xalign">0</property>
            <property name="wrap">true</property>
            <style>
              <class name="dim-label"/>
              <class name="caption"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="details_label">
            <property name="visible">false</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="action_box">
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="setup_button">
                <property name="label" translatable="yes">Set Up</property>
                <property name="hexpand">true</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="secondary_button">
                <property name="visible">false</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
