<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="AdventureModsWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Adventure Mods</property>
    <property name="default-width">872</property>
    <property name="default-height">666</property>
    <property name="width-request">360</property>
    <property name="height-request">480</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwNavigationView" id="navigation_view">
            <child>
              <object class="AdwNavigationPage">
                <property name="tag">welcome</property>
                <property name="title" translatable="yes">Adventure Mods</property>
                <property name="child">
                  <object class="AdwToolbarView">
                    <child type="top">
                      <object class="AdwHeaderBar" id="header_bar">
                        <child type="end">
                          <object class="GtkButton" id="refresh_button">
                            <property name="tooltip-text" translatable="yes">Scan Steam Libraries Again</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkStack" id="refresh_stack">
                                <property name="transition-type">crossfade</property>
                                <child>
                                  <object class="GtkImage" id="refresh_icon">
                                    <property name="icon-name">view-refresh-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwSpinner" id="refresh_spinner"/>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="top">
                      <object class="GtkRevealer" id="status_revealer">
                        <property name="reveal-child">false</property>
                        <property name="transition-type">slide-down</property>
                        <property name="child">
                          <object class="GtkBox" id="status_banner">
                            <property name="spacing">12</property>
                            <style>
                              <class name="status-banner"/>
                            </style>
                            <child>
                              <object class="GtkImage" id="status_icon">
                                <property name="icon-name">dialog-information-symbolic</property>
                                <property name="valign">start</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="status_label">
                                <property name="wrap">true</property>
                                <property name="xalign">0</property>
                                <property name="hexpand">true</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <property name="content">
                      <object class="AdventureModsWelcomePage" id="welcome_page"/>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
